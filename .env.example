# Runtime model backend: fixture | gemini | record
#   fixture  - deterministic canned model output. No key needed. Default, and what CI uses.
#   gemini   - live Gemini API. Needs GEMINI_API_KEY.
#   record   - live Gemini API, and writes cassettes to tests/cassettes/ as it goes.
MODEL_BACKEND=fixture

# Only needed for MODEL_BACKEND=gemini or record.
# Put the real value in .env (gitignored), never here -- this file is committed.
GEMINI_API_KEY=

# Optional: dense embeddings via the Gemini embedding API instead of the built-in
# dependency-free hashing embedder. See README "Retrieval" for the trade-off.
EMBED_BACKEND=hashing
